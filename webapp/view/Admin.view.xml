<mvc:View
    controllerName="com.xpto.thankyou.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    core:require="{ formatter: 'com/xpto/thankyou/model/formatter' }"
>
    <Page id="adminPage" busy="{admin>/busy}">
        <customHeader>
            <Bar id="adminHeaderBar">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="{i18n>backToHomeTooltip}"
                        press=".onBackPress"
                    />
                    <Title text="{i18n>adminDashboardTitle}" level="H1" />
                </contentLeft>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiResponsiveMargin" id="adminContent">
                <!-- KPIs -->
                <HBox alignItems="Center" wrap="Wrap" class="sapUiMediumMarginBottom" gap="1rem">
                    <GenericTile class="thankyouKpiTile" header="{i18n>kpiTotalRecognitionsLabel}" frameType="TwoByOne">
                        <TileContent>
                            <NumericContent value="{admin>/kpis/totalRecognitions}" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="thankyouKpiTile" header="{i18n>kpiTotalAverageLabel}" frameType="TwoByOne">
                        <TileContent>
                            <NumericContent value="{admin>/kpis/totalAveragePercent}" scale="%" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile class="thankyouKpiTile" header="{i18n>kpiActiveUsersLabel}" frameType="TwoByOne">
                        <TileContent>
                            <NumericContent value="{admin>/kpis/activeUsers}" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <l:Grid hSpacing="1" vSpacing="1">
                    <!-- Coluna esquerda: Top Performers em cartões verticais -->
                    <VBox class="thankyouListPanel">
                        <layoutData>
                            <l:GridData span="L3 M4 S12" />
                        </layoutData>
                        <Title text="{i18n>adminTopPerformersTitle}" level="H2" class="sapUiSmallMarginBottom" />
                        <VBox items="{admin>/topPerformers}">
                            <HBox alignItems="Center" gap="0.5rem" class="thankyouRankRow">
                                <Avatar
                                    displaySize="S"
                                    initials="{path: 'admin>employee/name', formatter: 'formatter.initials'}"
                                />
                                <VBox width="100%">
                                    <Text text="{admin>employee/name}" class="sapMTextBold" />
                                    <Text text="{path: 'admin>averageRating', formatter: 'formatter.ratingWithMax'}" />
                                </VBox>
                                <ObjectNumber number="{admin>recognitionCount}" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Coluna direita -->
                    <VBox>
                        <layoutData>
                            <l:GridData span="L9 M8 S12" />
                        </layoutData>

                        <!-- Categorias -->
                        <VBox class="thankyouListPanel sapUiMediumMarginBottom">
                            <Title text="{i18n>adminCategoriesChartTitle}" level="H2" class="sapUiSmallMarginBottom" />
                            <MessageStrip
                                text="{i18n>adminCategoriesChartEmpty}"
                                type="Information"
                                showIcon="true"
                                visible="{= !${admin>/categoryChartSvg} }"
                            />
                            <HBox wrap="Wrap" alignItems="Center" gap="1.5rem" visible="{= !!${admin>/categoryChartSvg} }">
                                <core:HTML
                                    id="categoryChart"
                                    content="{admin>/categoryChartSvg}"
                                    tooltip="{admin>/categoryChartAriaLabel}"
                                />
                                <VBox items="{admin>/categoryLegend}">
                                    <HBox alignItems="Center" gap="0.5rem" class="sapUiTinyMarginBottom">
                                        <HBox class="thankyouLegendSwatch {admin>swatchClass}" />
                                        <Text text="{admin>label}" />
                                        <Text text="{admin>value}" class="sapUiTinyMarginBeginEnd" />
                                    </HBox>
                                </VBox>
                            </HBox>
                            <Text text="{admin>/categoryChartAriaLabel}" class="thankyouChartCaption sapUiTinyMarginTop" />
                        </VBox>

                        <!-- Reconhecimentos -->
                        <VBox class="thankyouListPanel sapUiMediumMarginBottom">
                            <Title text="{i18n>adminRecognitionsTableTitle}" level="H2" class="sapUiTinyMarginBottom" />
                            <SearchField
                                id="recentSearchField"
                                placeholder="{i18n>searchPlaceholder}"
                                liveChange=".onRecentSearch"
                                class="sapUiTinyMarginBottom"
                            />
                            <Table id="recentTable" items="{admin>/recentRecognitions}" noDataText="{i18n>adminRecognitionsEmpty}">
                                <columns>
                                    <Column><Text text="{i18n>columnAuthor}" /></Column>
                                    <Column hAlign="Center"><Text text="{i18n>columnDate}" /></Column>
                                    <Column hAlign="Center"><Text text="{i18n>columnRating}" /></Column>
                                    <Column hAlign="Center" />
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox alignItems="Center" gap="0.5rem">
                                                <Avatar
                                                    displaySize="XS"
                                                    initials="{parts: [{path: 'admin>author/name'}, {path: 'admin>isAnonymous'}], formatter: 'formatter.avatarInitials'}"
                                                    src="{parts: [{path: 'admin>author/name'}, {path: 'admin>isAnonymous'}], formatter: 'formatter.avatarIcon'}"
                                                />
                                                <Text
                                                    text="{parts: [{path: 'admin>author/name'}, {path: 'i18n>anonymousAuthor'}], formatter: 'formatter.authorDisplayName'}"
                                                />
                                            </HBox>
                                            <Text text="{path: 'admin>createdAt', formatter: 'formatter.shortDate'}" />
                                            <Text text="{path: 'admin>overallRating', formatter: 'formatter.ratingWithMax'}" />
                                            <Button text="{i18n>viewDetailButton}" type="Transparent" enabled="false" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <!-- Reconhecimentos por mês -->
                        <VBox class="thankyouListPanel">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
                                <Title text="{i18n>adminRecognitionsByMonthTitle}" level="H2" />
                                <HBox alignItems="Center" gap="0.5rem">
                                    <Label text="{i18n>yearSelectorLabel}" labelFor="yearSelect" />
                                    <Select id="yearSelect" items="{admin>/yearOptions}" selectedKey="{admin>/selectedYear}" change=".onYearChange">
                                        <core:Item key="{admin>key}" text="{admin>text}" />
                                    </Select>
                                </HBox>
                            </HBox>
                            <core:HTML id="monthChart" content="{admin>/monthChartSvg}" tooltip="{admin>/monthChartAriaLabel}" />
                            <Text text="{admin>/monthChartAriaLabel}" class="thankyouChartCaption sapUiTinyMarginTop" />
                        </VBox>
                    </VBox>
                </l:Grid>
            </VBox>
        </content>
    </Page>
</mvc:View>
